{
  "name": "flypc-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/system/console/server",
    "src/system/console/client/web/flypc",
    "src/system/console/client/desktop",
    "src/system/console/client/mobile"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "dev:server": "npm run dev -w @flypc/server",
    "dev:web": "npm run dev -w @flypc/web",
    "dev:desktop": "npm run dev -w @flypc/desktop",
    "dev:mobile": "npm run dev -w @flypc/mobile",
    "build": "npm run build -w @flypc/web && npm run build -w @flypc/server",
    "build:desktop": "npm run build -w @flypc/desktop",
    "build:mobile": "npm run build:web -w @flypc/mobile",
    "package:desktop:windows": "npm run package:windows -w @flypc/desktop",
    "package:desktop:linux": "npm run package:linux -w @flypc/desktop",
    "package:mobile:android": "npm run build:android -w @flypc/mobile",
    "package:mobile:ios": "npm run build:ios -w @flypc/mobile",
    "build:apps": "npm run package:desktop:windows && npm run package:desktop:linux && npm run package:mobile:android && npm run package:mobile:ios",
    "start": "npm run start -w @flypc/server",
    "test": "npm run test -w @flypc/server && npm run test -w @flypc/web"
  }
}
